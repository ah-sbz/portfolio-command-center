---
interface Props {
  name: string;
  status: string;
  target: string;
  lastUpdated: string;
  nextAction: string;
}
const { name, status, target, lastUpdated, nextAction } = Astro.props;

const statusClass = {
  'on-track': 'status-on-track',
  'watch': 'status-watch',
  'blocked': 'status-blocked',
}[status] ?? 'status-watch';

const statusLabel = {
  'on-track': 'On Track',
  'watch': 'Watch',
  'blocked': 'Blocked',
}[status] ?? status;
---

<div class="card">
  <div class="card-title">{name}</div>
  <div class="stack">
    <div class="status-badge {statusClass}">
      <span class="status-dot"></span>
      {statusLabel}
    </div>
    <p style="font-size: 0.875rem; color: var(--text-muted);">Target: {target}</p>
    <p style="font-size: 0.875rem;"><strong>Next action:</strong> {nextAction}</p>
    <p class="timestamp">Updated: {lastUpdated}</p>
  </div>
</div>
